config {
  type: "table",
  schema: "us_taxi_trips",
  name: "map_demand_pressure",
  description: "(Q4) Map-ready pickup location demand pressure by date, time bucket, and community area."
}

WITH latest_trip AS (
  SELECT
    MAX(trip_date) AS latest_trip_date
  FROM ${ref("fct_taxi_trips")}
)

SELECT
  trips.trip_date,
  trips.pickup_community_area,

  trips.pickup_latitude,
  trips.pickup_longitude,
  trips.pickup_location,

  CASE
    WHEN trips.trip_hour BETWEEN 0 AND 5 THEN 'Late Night'
    WHEN trips.trip_hour BETWEEN 6 AND 11 THEN 'Morning'
    WHEN trips.trip_hour BETWEEN 12 AND 17 THEN 'Afternoon'
    WHEN trips.trip_hour BETWEEN 18 AND 23 THEN 'Evening'
  END AS time_bucket,

  latest_trip.latest_trip_date AS analysis_end_date,
  DATE_SUB(latest_trip.latest_trip_date, INTERVAL 3 MONTH) AS analysis_start_date,

  trips.trip_date > DATE_SUB(
    latest_trip.latest_trip_date,
    INTERVAL 3 MONTH
  ) AS is_latest_3_months,

  COUNT(*) AS trip_count,
  COUNT(DISTINCT trips.taxi_id) AS active_taxi_count,

  ROUND(SUM(trips.trip_total), 2) AS total_trip_revenue,
  ROUND(AVG(trips.trip_total), 2) AS average_trip_total,

  ROUND(
    SAFE_DIVIDE(
      COUNT(*),
      COUNT(DISTINCT trips.taxi_id)
    ),
    2
  ) AS trips_per_active_taxi

FROM ${ref("fct_taxi_trips")} AS trips
CROSS JOIN latest_trip
WHERE trips.pickup_latitude IS NOT NULL
  AND trips.pickup_longitude IS NOT NULL
  AND trips.pickup_community_area IS NOT NULL
GROUP BY
  trips.trip_date,
  trips.pickup_community_area,
  trips.pickup_latitude,
  trips.pickup_longitude,
  trips.pickup_location,
  time_bucket,
  latest_trip.latest_trip_date
HAVING trip_count >= 10