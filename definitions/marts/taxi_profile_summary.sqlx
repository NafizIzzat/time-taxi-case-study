config {
  type: "table",
  schema: "us_taxi_trips",
  name: "taxi_profile_summary",
  description: "Daily taxi profile summary for executive-level dataset snapshot and taxi ID lookup."
}

WITH latest_trip AS (
  SELECT
    MAX(trip_date) AS latest_trip_date
  FROM ${ref("fct_taxi_trips")}
)

SELECT
  trips.trip_date,
  trips.trip_year,
  trips.trip_month,
  trips.trip_day_of_week,
  trips.trip_hour,

  trips.taxi_id,
  SUBSTR(trips.taxi_id, 1, 8) AS taxi_display_id,
  trips.company,
  trips.payment_type,

  trips.pickup_community_area,
  trips.dropoff_community_area,

  latest_trip.latest_trip_date AS analysis_end_date,
  DATE_SUB(latest_trip.latest_trip_date, INTERVAL 3 MONTH) AS analysis_start_date,

  trips.trip_date > DATE_SUB(
    latest_trip.latest_trip_date,
    INTERVAL 3 MONTH
  ) AS is_latest_3_months,

  COUNT(*) AS trip_count,
  COUNT(DISTINCT trips.unique_key) AS trip_record_count,

  ROUND(SUM(trips.trip_miles), 2) AS total_miles,
  ROUND(SUM(trips.trip_hours), 2) AS total_driving_hours,

  ROUND(SUM(trips.fare), 2) AS total_fare,
  ROUND(SUM(trips.tips), 2) AS total_tips,
  ROUND(SUM(trips.tolls), 2) AS total_tolls,
  ROUND(SUM(trips.extras), 2) AS total_extras,
  ROUND(SUM(trips.trip_total), 2) AS total_trip_value,

  ROUND(AVG(trips.trip_miles), 2) AS average_trip_miles,
  ROUND(AVG(trips.trip_hours), 2) AS average_trip_hours,
  ROUND(AVG(trips.trip_total), 2) AS average_trip_value,

  MIN(trips.trip_start_timestamp) AS first_trip_timestamp,
  MAX(trips.trip_start_timestamp) AS last_trip_timestamp

FROM ${ref("fct_taxi_trips")} AS trips
CROSS JOIN latest_trip
WHERE trips.taxi_id IS NOT NULL
GROUP BY
  trips.trip_date,
  trips.trip_year,
  trips.trip_month,
  trips.trip_day_of_week,
  trips.trip_hour,
  trips.taxi_id,
  taxi_display_id,
  trips.company,
  trips.payment_type,
  trips.pickup_community_area,
  trips.dropoff_community_area,
  latest_trip.latest_trip_date