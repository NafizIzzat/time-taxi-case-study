config {
  type: "table",
  schema: "us_taxi_trips",
  name: "top_tip_earners",
  description: "(Q1) Top 100 taxi IDs by total tips over the latest 3 months available in the dataset."
}

WITH latest_trip AS (
  SELECT
    MAX(trip_date) AS latest_trip_date
  FROM ${ref("fct_taxi_trips")}
),

filtered_trips AS (
  SELECT
    trips.*
  FROM ${ref("fct_taxi_trips")} AS trips
  CROSS JOIN latest_trip
  WHERE trips.trip_date > DATE_SUB(latest_trip.latest_trip_date, INTERVAL 3 MONTH)
)

SELECT
  taxi_id,
  SUBSTR(taxi_id, 1, 8) AS taxi_display_id,
  COUNT(*) AS trip_count,
  COUNT(DISTINCT trip_date) AS active_days,

  ROUND(SUM(tips), 2) AS total_tips,
  ROUND(AVG(tips), 2) AS average_tip_per_trip,
  ROUND(AVG(trip_miles), 2) AS average_trip_miles,
  ROUND(AVG(trip_hours), 2) AS average_trip_hours,

  ROUND(SUM(fare), 2) AS total_fare,
  ROUND(SUM(trip_total), 2) AS total_trip_revenue,

  ROUND(SAFE_DIVIDE(SUM(tips), SUM(fare)), 4) AS tip_to_fare_ratio,
  ROUND(SAFE_DIVIDE(SUM(tips), COUNT(*)), 2) AS tips_per_trip,
  ROUND(SAFE_DIVIDE(COUNT(*), COUNT(DISTINCT trip_date)), 2) AS trips_per_active_day,

  MIN(trip_start_timestamp) AS first_trip_timestamp,
  MAX(trip_start_timestamp) AS last_trip_timestamp

FROM filtered_trips
WHERE taxi_id IS NOT NULL
  AND tips IS NOT NULL
  AND tips > 0
GROUP BY taxi_id
ORDER BY total_tips DESC
LIMIT 100