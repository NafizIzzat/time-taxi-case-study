config {
  type: "table",
  schema: "us_taxi_trips",
  name: "holiday_trip_impact",
  description: "(Q3) Compares Chicago taxi trip activity on US public holidays against comparable non-holiday weekdays."
}

WITH us_holidays AS (
  SELECT DISTINCT
    primary_date AS holiday_date,
    holiday_name
  FROM ${ref("holidays_and_events_for_forecasting")}
  WHERE region = 'US'
),

daily_with_holidays AS (
  SELECT
    daily.*,
    holidays.holiday_name,
    holidays.holiday_date IS NOT NULL AS is_public_holiday
  FROM ${ref("agg_daily_trips")} AS daily
  LEFT JOIN us_holidays AS holidays
    ON daily.trip_date = holidays.holiday_date
),

weekday_baseline AS (
  SELECT
    trip_day_of_week,
    AVG(trip_count) AS baseline_trip_count,
    AVG(active_taxi_count) AS baseline_active_taxi_count,
    AVG(total_trip_revenue) AS baseline_total_revenue,
    AVG(average_trip_total) AS baseline_average_trip_total,
    AVG(average_trip_miles) AS baseline_average_trip_miles
  FROM daily_with_holidays
  WHERE is_public_holiday = FALSE
  GROUP BY trip_day_of_week
)

SELECT
  daily_with_holidays.trip_date,
  daily_with_holidays.holiday_name,
  daily_with_holidays.trip_day_of_week,

  daily_with_holidays.trip_count,
  ROUND(weekday_baseline.baseline_trip_count, 2) AS comparable_weekday_trip_baseline,
  ROUND(
    SAFE_DIVIDE(
      daily_with_holidays.trip_count - weekday_baseline.baseline_trip_count,
      weekday_baseline.baseline_trip_count
    ),
    4
  ) AS trip_count_pct_difference,

  daily_with_holidays.active_taxi_count,
  ROUND(weekday_baseline.baseline_active_taxi_count, 2) AS comparable_weekday_active_taxi_baseline,

  daily_with_holidays.total_trip_revenue,
  ROUND(weekday_baseline.baseline_total_revenue, 2) AS comparable_weekday_revenue_baseline,
  ROUND(
    SAFE_DIVIDE(
      daily_with_holidays.total_trip_revenue - weekday_baseline.baseline_total_revenue,
      weekday_baseline.baseline_total_revenue
    ),
    4
  ) AS revenue_pct_difference,

  daily_with_holidays.average_trip_total,
  ROUND(weekday_baseline.baseline_average_trip_total, 2) AS comparable_weekday_average_trip_total_baseline,

  daily_with_holidays.average_trip_miles,
  ROUND(weekday_baseline.baseline_average_trip_miles, 2) AS comparable_weekday_average_trip_miles_baseline

FROM daily_with_holidays
LEFT JOIN weekday_baseline
  ON daily_with_holidays.trip_day_of_week = weekday_baseline.trip_day_of_week
WHERE daily_with_holidays.is_public_holiday = TRUE
ORDER BY daily_with_holidays.trip_date
