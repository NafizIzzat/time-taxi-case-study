config {
  type: "table",
  schema: "us_taxi_trips",
  name: "top_overworkers",
  description: "(Q2.3) Shift-level overworker table."
}

SELECT
  taxi_id,
  SUBSTR(taxi_id, 1, 8) AS taxi_display_id,
  shift_number,

  DATE(shift_start_timestamp) AS shift_date,
  shift_start_timestamp,
  shift_end_timestamp,

  shift_duration_minutes,
  shift_duration_hours,

  trips_in_shift,
  driving_hours_in_shift,
  miles_in_shift,
  revenue_in_shift,
  tips_in_shift,

  is_long_shift,
  CASE
    WHEN is_long_shift THEN 1
    ELSE 0
  END AS long_shift_flag,

  CASE
    WHEN is_long_shift THEN shift_duration_hours
    ELSE NULL
  END AS long_shift_hours

FROM ${ref("int_taxi_shifts")}
WHERE shift_duration_hours <= 16
--AND taxi_id = '4825026420c27470293dd6a32635f16b4b9bd14c92270c99cafb1303fbe609803ee3c29ee9d5c85d6b6ff97972dffb61ce2c16482661f02d4ad43d7366f99d28'
