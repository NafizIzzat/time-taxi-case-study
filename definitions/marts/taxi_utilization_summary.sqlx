config {
  type: "table",
  schema: "us_taxi_trips",
  name: "taxi_utilization_summary",
  description: "(Q4.2) Summarizes taxi utilization to support licensing and fleet saturation analysis."
}

SELECT
  taxi_id,

  COUNT(*) AS trip_count,
  COUNT(DISTINCT trip_date) AS active_days,

  ROUND(SUM(trip_hours), 2) AS total_driving_hours,
  ROUND(SUM(trip_miles), 2) AS total_miles,
  ROUND(SUM(trip_total), 2) AS total_revenue,
  ROUND(SUM(tips), 2) AS total_tips,

  ROUND(SAFE_DIVIDE(COUNT(*), COUNT(DISTINCT trip_date)), 2) AS trips_per_active_day,
  ROUND(SAFE_DIVIDE(SUM(trip_hours), COUNT(DISTINCT trip_date)), 2) AS driving_hours_per_active_day,
  ROUND(SAFE_DIVIDE(SUM(trip_total), COUNT(DISTINCT trip_date)), 2) AS revenue_per_active_day,

  MIN(trip_date) AS first_active_date,
  MAX(trip_date) AS last_active_date

FROM ${ref("fct_taxi_trips")}
WHERE taxi_id IS NOT NULL
GROUP BY taxi_id
HAVING active_days >= 5
ORDER BY
  driving_hours_per_active_day DESC,
  trips_per_active_day DESC,
  revenue_per_active_day DESC