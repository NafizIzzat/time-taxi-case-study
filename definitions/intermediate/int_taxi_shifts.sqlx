config {
  type: "table",
  schema: "us_taxi_trips",
  name: "int_taxi_shifts",
  description: "(Q2.2) Estimated total taxi work shifts based on taxi_trips_ordered and 8-hour break rule"
}

WITH shift_counter AS (
  SELECT
    *,
    SUM(CASE WHEN starts_new_shift THEN 1 ELSE 0 END) OVER (PARTITION BY taxi_id ORDER BY trip_start_timestamp, trip_end_timestamp, unique_key) AS shift_number --tag taxi_id by shifts
  FROM ${ref("int_taxi_trips_ordered")}
)

SELECT
  taxi_id,
  shift_number,

  MIN(trip_start_timestamp) AS shift_start_timestamp,
  MAX(trip_end_timestamp) AS shift_end_timestamp,
  
  TIMESTAMP_DIFF(MAX(trip_end_timestamp), MIN(trip_start_timestamp), MINUTE) AS shift_duration_minutes,
  ROUND(SAFE_DIVIDE( TIMESTAMP_DIFF( MAX(trip_end_timestamp), MIN(trip_start_timestamp), MINUTE), 60), 2) AS shift_duration_hours, --full duration including breaks

  COUNT(*) AS trips_in_shift,
  ROUND(SUM(trip_hours), 2) AS driving_hours_in_shift, --actual trip time 
  ROUND(SUM(trip_miles), 2) AS miles_in_shift,
  ROUND(SUM(trip_total), 2) AS revenue_in_shift,
  ROUND(SUM(tips), 2) AS tips_in_shift,

  CASE
    WHEN TIMESTAMP_DIFF( MAX(trip_end_timestamp), MIN(trip_start_timestamp), MINUTE) >= 720 THEN TRUE --12 hours
    ELSE FALSE
  END AS is_long_shift

FROM shift_counter
GROUP BY
  taxi_id,
  shift_number
